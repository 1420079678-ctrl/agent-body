{
  "name": "@dsh-external/dsh-minimal-gray",
  "version": "0.1.0",
  "description": "极简灰度版 Agent 预设（Minimal Gray）— 以极简模式为底，平台自适应 Shell（Windows→PowerShell，Unix→Bash），精选文件/搜索/网页/待办/后台任务/技能/目标工具的最小组合。注入即自动安装到 DSH_HOME/.agent-presets（热加载，无需重启）。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": ["lib", "presets"],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
