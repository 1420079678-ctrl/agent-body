# Environment template for this install. Copy to `.env` and fill in — never commit `.env`.
# The harness itself reads credentials from `data/.credentials.yaml`; these variables are for
# launching the host from source and for scripted/CI runs.

# ── Required to launch the web GUI from source ────────────────────────────────
DSH_HOME=<DSH_CHECKOUT>\data

# ── Optional ──────────────────────────────────────────────────────────────────
# Port for `npm run start:web` (default 3090).
DSH_WEB_PORT=3090

# Set to 1 only on machines behind a TLS-inspecting proxy; disables certificate checks.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Force the multi-engine crawler to serve as the harness web-fetch provider.
# DSH_WEBCRAWL_FETCH_PROVIDER=1
# DSH_WEB_FETCH_PROVIDER=webcrawl

# ── Provider keys (optional; only if you bypass data/.credentials.yaml) ───────
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
