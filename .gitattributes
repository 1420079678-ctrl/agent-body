# Normalize to LF in the repository; keep Windows scripts usable on checkout.
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binaries — never diff, never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.exe  binary
*.dll  binary
*.node binary

# Vendored / generated trees: keep them out of diff stats and language stats
workspace/plugins/dsh-web-crawl/vendor/** -diff linguist-vendored
workspace/plugins/*/lib/**          -diff linguist-generated
app/**                              linguist-vendored

# Keep merge drivers predictable for data files
*.jsonl -diff
